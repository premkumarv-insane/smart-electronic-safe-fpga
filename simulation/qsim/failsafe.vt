// *****************************************************************************
// This file contains a Verilog test bench with test vectors .The test vectors  
// are exported from a vector file in the Quartus Waveform Editor and apply to  
// the top level entity of the current Quartus project .The user can use this   
// testbench to simulate his design using a third-party simulation tool .       
// *****************************************************************************
// Generated on "10/10/2026 19:58:21"
                                                                        
// Verilog Self-Checking Test Bench (with test vectors) for design :    failsafe
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module failsafe_vlg_sample_tst(
	SW0,
	SW1,
	SW2,
	SW3,
	SW4,
	SW5,
	sampler_tx
);
input  SW0;
input  SW1;
input  SW2;
input  SW3;
input  SW4;
input  SW5;
output sampler_tx;

reg sample;
time current_time;
always @(SW0 or SW1 or SW2 or SW3 or SW4 or SW5)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module failsafe_vlg_check_tst (
	LEDG0,
	LEDG1,
	LEDG2,
	LEDG3,
	sampler_rx
);
input  LEDG0;
input  LEDG1;
input  LEDG2;
input  LEDG3;
input sampler_rx;

reg  LEDG0_expected;
reg  LEDG1_expected;
reg  LEDG2_expected;
reg  LEDG3_expected;

reg  LEDG0_prev;
reg  LEDG1_prev;
reg  LEDG2_prev;
reg  LEDG3_prev;

reg  LEDG0_expected_prev;
reg  LEDG1_expected_prev;
reg  LEDG2_expected_prev;
reg  LEDG3_expected_prev;

reg  last_LEDG0_exp;
reg  last_LEDG1_exp;
reg  last_LEDG2_exp;
reg  last_LEDG3_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:4] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 4'b1;
end

// update real /o prevs

always @(trigger)
begin
	LEDG0_prev = LEDG0;
	LEDG1_prev = LEDG1;
	LEDG2_prev = LEDG2;
	LEDG3_prev = LEDG3;
end

// update expected /o prevs

always @(trigger)
begin
	LEDG0_expected_prev = LEDG0_expected;
	LEDG1_expected_prev = LEDG1_expected;
	LEDG2_expected_prev = LEDG2_expected;
	LEDG3_expected_prev = LEDG3_expected;
end



// expected LEDG0
initial
begin
	LEDG0_expected = 1'bX;
end 

// expected LEDG1
initial
begin
	LEDG1_expected = 1'bX;
end 

// expected LEDG2
initial
begin
	LEDG2_expected = 1'bX;
end 

// expected LEDG3
initial
begin
	LEDG3_expected = 1'bX;
end 
// generate trigger
always @(LEDG0_expected or LEDG0 or LEDG1_expected or LEDG1 or LEDG2_expected or LEDG2 or LEDG3_expected or LEDG3)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected LEDG0 = %b | expected LEDG1 = %b | expected LEDG2 = %b | expected LEDG3 = %b | ",LEDG0_expected_prev,LEDG1_expected_prev,LEDG2_expected_prev,LEDG3_expected_prev);
	$display("| real LEDG0 = %b | real LEDG1 = %b | real LEDG2 = %b | real LEDG3 = %b | ",LEDG0_prev,LEDG1_prev,LEDG2_prev,LEDG3_prev);
`endif
	if (
		( LEDG0_expected_prev !== 1'bx ) && ( LEDG0_prev !== LEDG0_expected_prev )
		&& ((LEDG0_expected_prev !== last_LEDG0_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LEDG0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LEDG0_expected_prev);
		$display ("     Real value = %b", LEDG0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_LEDG0_exp = LEDG0_expected_prev;
	end
	if (
		( LEDG1_expected_prev !== 1'bx ) && ( LEDG1_prev !== LEDG1_expected_prev )
		&& ((LEDG1_expected_prev !== last_LEDG1_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LEDG1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LEDG1_expected_prev);
		$display ("     Real value = %b", LEDG1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_LEDG1_exp = LEDG1_expected_prev;
	end
	if (
		( LEDG2_expected_prev !== 1'bx ) && ( LEDG2_prev !== LEDG2_expected_prev )
		&& ((LEDG2_expected_prev !== last_LEDG2_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LEDG2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LEDG2_expected_prev);
		$display ("     Real value = %b", LEDG2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_LEDG2_exp = LEDG2_expected_prev;
	end
	if (
		( LEDG3_expected_prev !== 1'bx ) && ( LEDG3_prev !== LEDG3_expected_prev )
		&& ((LEDG3_expected_prev !== last_LEDG3_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port LEDG3 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", LEDG3_expected_prev);
		$display ("     Real value = %b", LEDG3_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_LEDG3_exp = LEDG3_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#100000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module failsafe_vlg_vec_tst();
// constants                                           
// general purpose registers
reg SW0;
reg SW1;
reg SW2;
reg SW3;
reg SW4;
reg SW5;
// wires                                               
wire LEDG0;
wire LEDG1;
wire LEDG2;
wire LEDG3;

wire sampler;                             

// assign statements (if any)                          
failsafe i1 (
// port map - connection between master ports and signals/registers   
	.LEDG0(LEDG0),
	.LEDG1(LEDG1),
	.LEDG2(LEDG2),
	.LEDG3(LEDG3),
	.SW0(SW0),
	.SW1(SW1),
	.SW2(SW2),
	.SW3(SW3),
	.SW4(SW4),
	.SW5(SW5)
);

// SW0
initial
begin
	SW0 = 1'b1;
	SW0 = #10000 1'b0;
	SW0 = #30000 1'b1;
	SW0 = #10000 1'b0;
	SW0 = #10000 1'b1;
	SW0 = #10000 1'b0;
end 

// SW1
initial
begin
	SW1 = 1'b1;
	SW1 = #10000 1'b0;
	SW1 = #10000 1'b1;
	SW1 = #10000 1'b0;
	SW1 = #10000 1'b1;
	SW1 = #10000 1'b0;
	SW1 = #10000 1'b1;
	SW1 = #10000 1'b0;
end 

// SW2
initial
begin
	SW2 = 1'b0;
	SW2 = #20000 1'b1;
	SW2 = #10000 1'b0;
	SW2 = #10000 1'b1;
	SW2 = #10000 1'b0;
end 

// SW3
initial
begin
	SW3 = 1'b1;
	SW3 = #10000 1'b0;
	SW3 = #30000 1'b1;
	SW3 = #10000 1'b0;
end 

// SW4
initial
begin
	SW4 = 1'b0;
	SW4 = #10000 1'b1;
	SW4 = #10000 1'b0;
	SW4 = #10000 1'b1;
	SW4 = #10000 1'b0;
	SW4 = #10000 1'b1;
	SW4 = #10000 1'b0;
	SW4 = #10000 1'b1;
	SW4 = #10000 1'b0;
end 

// SW5
initial
begin
	SW5 = 1'b0;
	SW5 = #80000 1'b1;
	SW5 = #10000 1'b0;
end 

failsafe_vlg_sample_tst tb_sample (
	.SW0(SW0),
	.SW1(SW1),
	.SW2(SW2),
	.SW3(SW3),
	.SW4(SW4),
	.SW5(SW5),
	.sampler_tx(sampler)
);

failsafe_vlg_check_tst tb_out(
	.LEDG0(LEDG0),
	.LEDG1(LEDG1),
	.LEDG2(LEDG2),
	.LEDG3(LEDG3),
	.sampler_rx(sampler)
);
endmodule

